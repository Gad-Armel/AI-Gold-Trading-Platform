# Optional. With a key, V6 uses the faster official FRED observations API;
# without one it falls back to FRED graph CSV. Never commit the real key.
FRED_API_KEY=
WORLD_BANK_GEP_ENABLED=1

XAUUSD_SYMBOL=XAUUSD
VFINAL_SNAPSHOT_INTERVAL_SECONDS=5
VFINAL_MIN_ROWS_TO_TRAIN=300
VFINAL_PREFERRED_ROWS=1000
VFINAL_MIN_EV_USD=0.02
VFINAL_MIN_PROBABILITY=0.55

# Optional existing-project providers (V-FINAL treats them as confirmation only)
OANDA_API_TOKEN=
OANDA_ENVIRONMENT=practice
TWELVE_DATA_API_KEY=
# Actual-versus-forecast economic calendars can require a paid FMP plan.
FMP_API_KEY=
ALPHA_VANTAGE_API_KEY=
BEA_API_KEY=
BLS_API_KEY=
OFFICIAL_RELEASE_MONITOR_ENABLED=1
OFFICIAL_RELEASE_REFRESH_SECONDS=60
# Optional overrides; the defaults are the official Census and Federal Reserve feeds.
CENSUS_ECONOMIC_RSS_URL=https://www.census.gov/economic-indicators/indicator.xml
FED_MONETARY_RSS_URL=https://www.federalreserve.gov/feeds/press_monetary.xml

# Optional. V6 refreshes WGC central-bank/ETF data and the public CFTC API
# automatically. A free Socrata token only raises the CFTC rate limit.
INSTITUTIONAL_AUTO_REFRESH_ENABLED=1
INSTITUTIONAL_REFRESH_SECONDS=21600
CFTC_SODA_APP_TOKEN=
